{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "installCommand": "pnpm install --frozen-lockfile",
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": "https://api.cardorb.com/api/v1/:path*"
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.cardorb.com"
                }
            ],
            "destination": "https://cardorb.com/:path*",
            "permanent": true
        }
    ]
}
