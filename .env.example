# Copy to .env.local and fill with your Supabase project values (Project Settings → API).
# .env.local is gitignored — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for metadata/openGraph. Optional in dev (defaults to localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Card Orb API this app reads cards, folders and profiles through (R-DATA-003).
# Defaults to production; point it at a local checkout of bartdunweg/cardorb-api to develop both.
CARDORB_API_URL=https://api.cardorb.com/v1
